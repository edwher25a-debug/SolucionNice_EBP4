<UserControl x:Class="ProyectoNice.Views.v_TuberiasporCAD"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding AceptarBT}">Crear tuberias</Button>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Tuberia">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center">Tipo</TextBlock>
                    <TextBlock Margin="0,6,0,0" Grid.Row="1">Sistema</TextBlock>
                    <TextBlock VerticalAlignment="Center" Grid.Row="2">Nivel</TextBlock>
                    <TextBlock VerticalAlignment="Center" Grid.Row="3">Diametro</TextBlock>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding LstTiposCB}" SelectedItem="{Binding TipoSeleccCB}" DisplayMemberPath="Name"/>
                    <ListBox Grid.Row="1" Grid.Column="1" Margin="0,3" Height="150" ItemsSource="{Binding LstSistLB}" SelectedItem="{Binding SistSeleccLB}" DisplayMemberPath="Name"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding LstNvlCB}" SelectedItem="{Binding NvlSeleccCB}" DisplayMemberPath="Name"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DiametroTX}"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="2" Header="CAD">
                <DockPanel>
                    <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding LstCADCB}" SelectedItem="{Binding CADSeleccCB}" DisplayMemberPath="Category.Name"/>
                    <TextBlock DockPanel.Dock="Top" Margin="0,6,0,3">Capa</TextBlock>
                    <ListBox ItemsSource="{Binding LstCapasCB}" SelectedItem="{Binding CapaSeleccCB}" DisplayMemberPath="Name"/>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</UserControl>
