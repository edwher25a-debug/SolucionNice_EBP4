<Window x:Class="ProyectoNice.Views.v_InsertFamily"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProyectoNice.Views"
        mc:Ignorable="d"
        Title="SCRIPT:Insertar Familias" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="2" Background="#FF143042" Foreground="White" Padding="6" Command="{Binding AceptarBT}">Seleccionar familias</Button>
            <Button Margin="2" Background="#FF143042" Foreground="White" Padding="6" Command="{Binding CancelarBT}">Cancelar</Button>
        </StackPanel>
        <GroupBox DockPanel.Dock="Top" Margin="2" Header="Familia de dos puntos" BorderBrush="#FF20292F">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Margin="4">Categoria</TextBlock>
                <TextBlock Margin="4" Grid.Row="1">Familia</TextBlock>
                <TextBlock Margin="4" Grid.Row="2">Tipo</TextBlock>
                <TextBlock Margin="4" Grid.Row="3">Nivel</TextBlock>

                <ComboBox Grid.Column="1" Margin="2" ItemsSource="{Binding ListaCategoriasCB}" SelectedItem="{Binding CategoriaSeleccCB}" DisplayMemberPath="Name"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="2" ItemsSource="{Binding ListaFamiliasCB}" SelectedItem="{Binding FamiliaSeleccCB}" DisplayMemberPath="Name"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="2" ItemsSource="{Binding ListaTiposCB}" SelectedItem="{Binding TipoSeleccCB}" DisplayMemberPath="Name"/>
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="2" ItemsSource="{Binding ListaNivelesCB}" SelectedItem="{Binding NivelSeleccCB}" DisplayMemberPath="Name"/>
            </Grid>
        </GroupBox>
    </DockPanel>
</Window>
