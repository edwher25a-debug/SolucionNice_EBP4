<UserControl x:Class="ProyectoNice.Views.v_TrabajoHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding AceptarBT}">Escribir coordenadas</Button>
        </StackPanel>
        <StackPanel>
            <GroupBox Header="Seleccion de elementos">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center">Categoria</TextBlock>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ListaCagoriasCB}" SelectedItem="{Binding CategoriasSeleccCB}" DisplayMemberPath="Name"/>
                </Grid>
            </GroupBox>
        </StackPanel>
    </DockPanel>
</UserControl>
