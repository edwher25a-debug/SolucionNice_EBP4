<Window x:Class="ProyectoNice.Views.v_Principal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProyectoNice.ViewModels"
        xmlns:local="clr-namespace:ProyectoNice.Views"
        Title="ProyectoNice" Width="860" Height="580" MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Fondo}" Foreground="{DynamicResource Texto}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ProyectoNice;component/Views/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--Menu agrupado-->
            <CollectionViewSource x:Key="MenuAgrupado" Source="{Binding Herramientas}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Grupo"/>
                </CollectionViewSource.GroupDescriptions>
            </CollectionViewSource>

            <!--Vista de cada herramienta segun su viewmodel-->
            <DataTemplate DataType="{x:Type vm:vm_ACEROS_PILOTES}"><local:v_ACEROS_PILOTES/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:vm_CrearSuelos}"><local:v_CrearSuelos/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:vm_TuberiasporCAD}"><local:v_TuberiasporCAD/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:vm_InsertFamily}"><local:v_InsertFamily/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:vm_CoordCompartidas}"><local:v_CoordCompartidas/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:vm_TrabajoHome}"><local:v_TrabajoHome/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TrabajoFinal}"><local:v_TrabajoFinal/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:vm_ExportarFichas}"><local:v_ExportarFichas/></DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!--Barra de estado-->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Primario}" Padding="16,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Background="{StaticResource PrimarioClaro}" Command="{Binding CerrarBT}" Content="Cerrar"/>
                <TextBlock Text="{Binding Estado}" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!--Menu lateral-->
        <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource Primario}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ProyectoNice" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="16,18,16,6"/>
                <ListBox Style="{StaticResource Menu}" ItemsSource="{Binding Source={StaticResource MenuAgrupado}}"
                         SelectedItem="{Binding HerramientaSelecc}" DisplayMemberPath="Nombre" IsSynchronizedWithCurrentItem="False">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource MenuGrupo}"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!--Herramienta activa-->
        <DockPanel Margin="24,18,24,16">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Style="{StaticResource Titulo}" Text="{Binding HerramientaSelecc.Nombre, FallbackValue='Bienvenido'}"/>
                <TextBlock Style="{StaticResource Subtitulo}" Text="{Binding HerramientaSelecc.Descripcion, FallbackValue='Elija una herramienta en el menu de la izquierda.'}"/>
            </StackPanel>
            <ContentControl Content="{Binding Contenido}" Focusable="False"/>
        </DockPanel>
    </DockPanel>
</Window>
