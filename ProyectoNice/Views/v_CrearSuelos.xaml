<UserControl x:Class="ProyectoNice.Views.v_CrearSuelos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding AceptarBT}">Crear suelo</Button>
        </StackPanel>
        <StackPanel>
            <GroupBox Header="Datos de entrada">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center">Nivel</TextBlock>
                    <TextBlock VerticalAlignment="Center" Grid.Row="1">Tipo de suelo</TextBlock>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding ListaNivelesCB}" SelectedItem="{Binding NivelSeleccCB}" DisplayMemberPath="Name"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ListaTiposCB}" SelectedItem="{Binding TipoSeleccCB}" DisplayMemberPath="Name"/>
                </Grid>
            </GroupBox>
        </StackPanel>
    </DockPanel>
</UserControl>
