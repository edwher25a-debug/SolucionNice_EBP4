<UserControl x:Class="ProyectoNice.Views.v_ParametrosPresupuesto"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox IsChecked="{Binding SoloVistaActiva}" VerticalAlignment="Center" Margin="0,0,12,0">Solo vista activa</CheckBox>
            <Button Command="{Binding CompararBT}">Comparar</Button>
            <Button Command="{Binding ExportarBT}">Exportar CSV</Button>
            <Button Command="{Binding AplicarBT}">Aplicar marcados</Button>
        </StackPanel>

        <GroupBox DockPanel.Dock="Top" Header="Presupuesto">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding AbrirBT}">Abrir Excel</Button>
                    <TextBlock Text="{Binding Archivo, FallbackValue=''}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Width="110" VerticalAlignment="Center">Hoja</TextBlock>
                    <ComboBox ItemsSource="{Binding ListaHojasCB}" SelectedItem="{Binding HojaSeleccCB}" Width="300" HorizontalAlignment="Left"/>
                </DockPanel>
                <TextBlock Text="{Binding ResumenExcel}" TextWrapping="Wrap" Foreground="{StaticResource TextoSuave}" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox DockPanel.Dock="Top" Header="Campos: columna del Excel y parámetro de Revit">
            <DataGrid ItemsSource="{Binding Campos}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Campo" Binding="{Binding Nombre}" IsReadOnly="True" Width="170"/>
                    <DataGridTemplateColumn Header="Columna del Excel" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Margin="0" ItemsSource="{Binding DataContext.Columnas, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          SelectedValuePath="Indice" DisplayMemberPath="Texto"
                                          SelectedValue="{Binding Columna, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Parámetro en Revit" Binding="{Binding Parametro, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Header="Cambios propuestos">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding MarcarVaciosBT}" Padding="10,4">Marcar solo vacíos</Button>
                        <Button Command="{Binding DesmarcarBT}" Padding="10,4">Desmarcar todo</Button>
                    </StackPanel>
                    <TextBlock Text="{Binding ResumenComparacion}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextoSuave}"/>
                </DockPanel>
                <DataGrid ItemsSource="{Binding Cambios}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="140">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Aplicar" Binding="{Binding Aplicar, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" IsReadOnly="True" Width="140"/>
                        <DataGridTextColumn Header="Ítem" Binding="{Binding Item}" IsReadOnly="True" Width="55"/>
                        <DataGridTextColumn Header="Familia" Binding="{Binding Familia}" IsReadOnly="True" Width="180"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="Elem." Binding="{Binding Elementos}" IsReadOnly="True" Width="45"/>
                        <DataGridTextColumn Header="Parámetro" Binding="{Binding Parametro}" IsReadOnly="True" Width="150"/>
                        <DataGridTextColumn Header="En" Binding="{Binding EnTipo}" IsReadOnly="True" Width="60"/>
                        <DataGridTextColumn Header="Valor en el modelo" Binding="{Binding ValorModelo}" IsReadOnly="True" Width="220"/>
                        <DataGridTextColumn Header="Valor del presupuesto" Binding="{Binding ValorPresupuesto}" IsReadOnly="True" Width="220"/>
                        <DataGridTextColumn Header="Cruzado por" Binding="{Binding CruzadoPor}" IsReadOnly="True" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
    </DockPanel>
</UserControl>
