<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--Paleta-->
    <SolidColorBrush x:Key="Primario" Color="#143042"/>
    <SolidColorBrush x:Key="PrimarioClaro" Color="#1E4A63"/>
    <SolidColorBrush x:Key="MenuTexto" Color="#CFE0EA"/>
    <SolidColorBrush x:Key="MenuGrupoTexto" Color="#8FA9B8"/>
    <SolidColorBrush x:Key="Fondo" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="Borde" Color="#D5DDE3"/>
    <SolidColorBrush x:Key="Texto" Color="#1F2A33"/>
    <SolidColorBrush x:Key="TextoSuave" Color="#5B6B78"/>

    <!--Textos-->
    <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
    </Style>
    <Style x:Key="Subtitulo" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
    </Style>
    <Style x:Key="MenuGrupo" TargetType="TextBlock">
        <Setter Property="Margin" Value="16,14,16,4"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource MenuGrupoTexto}"/>
    </Style>

    <!--Botones-->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primario}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,7"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fondo" Property="Background" Value="{StaticResource PrimarioClaro}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fondo" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Controles de entrada-->
    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Borde}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Borde}"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
    </Style>

    <!--Tarjeta para agrupar los datos de cada herramienta-->
    <Style TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="White" BorderBrush="{StaticResource Borde}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <DockPanel>
                            <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="0,0,0,8"
                                              TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource Primario}"/>
                            <ContentPresenter/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Menu lateral-->
    <Style x:Key="Menu" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource MenuTexto}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Fondo" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent" Padding="13,7,16,7">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Fondo" Property="Background" Value="{StaticResource PrimarioClaro}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Fondo" Property="Background" Value="{StaticResource PrimarioClaro}"/>
                                        <Setter TargetName="Fondo" Property="BorderBrush" Value="White"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
