<UserControl x:Class="ProyectoNice.Views.v_ExportarPlanos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding AbrirCarpetaBT}">Abrir carpeta</Button>
            <Button Command="{Binding AceptarBT}">Exportar</Button>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <GroupBox Header="Planos">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center">Conjunto de planos</TextBlock>
                        <TextBlock VerticalAlignment="Center" Grid.Row="1">Buscar por numero o nombre</TextBlock>

                        <ComboBox Grid.Column="1" ItemsSource="{Binding ListaConjuntosCB}" SelectedItem="{Binding ConjuntoSeleccCB}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FiltroTB, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <DataGrid ItemsSource="{Binding PlanosVisibles}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" Margin="0,6,0,0" MinHeight="120" MaxHeight="280">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="32">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding Seleccionado, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Numero" Binding="{Binding Numero}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="Revision" Binding="{Binding Revision}" IsReadOnly="True" Width="Auto"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Margin="0,6,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding MarcarTodosBT}">Marcar visibles</Button>
                            <Button Command="{Binding DesmarcarTodosBT}">Desmarcar visibles</Button>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextoSuave}" Text="{Binding ResumenSeleccion}"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="PDF">
                <StackPanel>
                    <CheckBox Margin="0,4" IsChecked="{Binding ExportarPdfCK}">Exportar a PDF</CheckBox>
                    <Grid IsEnabled="{Binding ExportarPdfCK}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <CheckBox Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding UnirPdfCK}">Todos los planos en un solo PDF</CheckBox>
                        <TextBlock VerticalAlignment="Center" Grid.Row="1">Nombre del PDF unico</TextBlock>
                        <TextBlock VerticalAlignment="Center" Grid.Row="2">Color</TextBlock>

                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NombrePdfUnicoTB}" IsEnabled="{Binding UnirPdfCK}"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding ListaColoresCB}" SelectedItem="{Binding ColorSeleccCB}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="DWG">
                <StackPanel>
                    <CheckBox Margin="0,4" IsChecked="{Binding ExportarDwgCK}">Exportar a DWG</CheckBox>
                    <Grid IsEnabled="{Binding ExportarDwgCK}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center">Configuracion de exportacion</TextBlock>
                        <TextBlock VerticalAlignment="Center" Grid.Row="1">Version de AutoCAD</TextBlock>

                        <ComboBox Grid.Column="1" ItemsSource="{Binding ListaConfigDwgCB}" SelectedItem="{Binding ConfigDwgSeleccCB}"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ListaVersionesCB}" SelectedItem="{Binding VersionSeleccCB}"/>
                        <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding UnirVistasCK}">Un solo DWG por plano (vistas dentro del archivo, sin referencias externas)</CheckBox>
                        <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding CoordCompartidasCK}">Usar coordenadas compartidas</CheckBox>
                    </Grid>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Nombre y carpeta">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center">Nombre de cada archivo</TextBlock>
                    <TextBlock VerticalAlignment="Center" Grid.Row="2">Carpeta de salida</TextBlock>

                    <ComboBox Grid.Column="1" ItemsSource="{Binding ListaFormatosNombreCB}" SelectedItem="{Binding FormatoNombreSeleccCB}"/>
                    <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4" IsChecked="{Binding IncluirRevisionCK}">Agregar la revision actual al nombre (" - Rev B")</CheckBox>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CarpetaTB, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Row="2" Grid.Column="2" Padding="10,3" Command="{Binding ElegirCarpetaBT}">...</Button>
                </Grid>
            </GroupBox>
            <TextBlock Foreground="{DynamicResource TextoSuave}" TextWrapping="Wrap">Los PDF quedan en la subcarpeta PDF y los DWG en la subcarpeta DWG. Si ya existe un archivo con el mismo nombre se reemplaza. El tamaño de hoja del PDF sale del cuadro de rotulacion de cada plano. La configuracion de exportacion DWG define capas, colores y unidades; las dos casillas de abajo se aplican encima de ella.</TextBlock>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
